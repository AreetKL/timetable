    <path
        android:fillColor="#00000000"
        android:strokeColor="#93A896"
        android:strokeWidth="2.94"
        android:strokeLineCap="round"
        android:pathData="M34.83,32.25 L34.83,75.75" />

    <!-- 第一条：当前这一节，暖黄、略粗 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E7B05C"
