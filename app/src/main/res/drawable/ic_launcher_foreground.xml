    <!-- 第二条：米白 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F4F0E4"
        android:strokeWidth="10.32"
        android:strokeLineCap="round"
        android:pathData="M45.4,54 L60.88,54" />

    <!-- 第三条：米白 -->
    <path
